{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context-atlas.dev/schema/context-snapshot-1.0.json",
  "title": "Context Atlas Snapshot 1.0",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "enum": ["api", "website", "full-stack", "learning", "general"]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": ["overview", "journey", "architecture", "api", "data", "work", "study"]
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "name", "description", "kind", "capabilities", "tags", "version"],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "freshness": {
            "enum": ["current", "stale", "unknown"]
          }
        },
        "required": ["id", "label", "path", "revision", "freshness"],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "module",
              "actor",
              "journey",
              "page",
              "operation",
              "service",
              "entity",
              "table",
              "task",
              "document",
              "decision",
              "test",
              "topic"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "moduleId": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": ["proposed", "implemented", "verified", "accepted"]
          },
          "evidence": {
            "enum": ["declared", "inferred", "reviewed"]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "details": {
            "type": "object",
            "properties": {
              "endpoint": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "authentication": {
                    "type": "string"
                  },
                  "request": {
                    "$ref": "#/$defs/json"
                  },
                  "responses": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/json"
                    }
                  },
                  "parameters": {
                    "$ref": "#/$defs/json"
                  }
                },
                "required": ["method", "path", "authentication", "responses"],
                "additionalProperties": false
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "primaryKey": {
                      "type": "boolean"
                    },
                    "references": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["name", "type"],
                  "additionalProperties": false
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "code": {
                "type": "string"
              },
              "task": {
                "type": "object",
                "properties": {
                  "state": {
                    "enum": ["todo", "in-progress", "blocked", "done"]
                  },
                  "priority": {
                    "enum": ["low", "medium", "high"]
                  }
                },
                "required": ["state", "priority"],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "description",
          "sourceIds",
          "status",
          "evidence",
          "tags"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence": {
            "enum": ["declared", "inferred", "reviewed"]
          }
        },
        "required": ["id", "source", "target", "relation", "sourceIds", "evidence"],
        "additionalProperties": false
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["overview", "journey", "architecture", "api", "data", "work", "study"]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "nodeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nodeId": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["nodeId", "label"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "kind", "label", "description", "nodeIds"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "project", "sources", "nodes", "edges", "views"],
  "additionalProperties": false,
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  }
}

      "evidence": "reviewed",
      "tags": ["PostgreSQL"],
      "id": "orders-table",
      "kind": "table",
      "label": "orders",
      "description": "Persists the order header. A separate order_items table preserves the submitted quantities.",
      "moduleId": "orders-module",
      "details": {
        "fields": [
          {
            "name": "id",
            "type": "uuid",
            "required": true,
            "primaryKey": true
          },
          {
            "name": "customer_id",
            "type": "uuid",
            "required": true
          },
          {
            "name": "status",
            "type": "varchar(24)",
            "required": true
          },
          {
            "name": "created_at",
            "type": "timestamptz",
            "required": true
          }
        ],
        "notes": ["Database shape is independent of the public response DTO."]
      }
    },
    {
      "sourceIds": ["commerce-schema"],

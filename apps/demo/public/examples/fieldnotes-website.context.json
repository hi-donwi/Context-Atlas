      "id": "subscribe-api",
      "kind": "operation",
      "label": "Subscribe to newsletter",
      "description": "A public endpoint validates the email and records a pending subscription. Examples use reserved example.invalid addresses.",
      "moduleId": "newsletter-module",
      "details": {
        "endpoint": {
          "method": "POST",
          "path": "/api/subscriptions",
          "authentication": "Public · rate limited by host",
          "request": {
            "schema": {
              "type": "object",
              "required": ["email"],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                }
              }
            },
            "example": {
              "email": "reader@example.invalid"
            }
          },
          "responses": {
            "202": {
              "description": "Signup accepted",
              "example": {
                "status": "pending-confirmation"
              }
            },
            "400": {
              "description": "Invalid email",
              "example": {
                "code": "INVALID_EMAIL"
              }
            },
            "429": {
              "description": "Too many requests"
            }
          }
        }
      }
    },

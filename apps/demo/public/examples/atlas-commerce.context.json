    {
      "sourceIds": ["commerce-api"],
      "status": "verified",
      "evidence": "reviewed",
      "tags": ["POST", "/api/orders"],
      "id": "create-order",
      "kind": "operation",
      "label": "Create an order",
      "moduleId": "orders-module",
      "description": "Accepts a customer reference and line items. Returns a created order or a declared validation error. The synthetic test evidence covers the contract, not deployment or UAT.",
      "details": {
        "endpoint": {
          "method": "POST",
          "path": "/api/orders",
          "authentication": "Bearer token · orders:create",
          "request": {
            "contentType": "application/json",
            "schema": {
              "type": "object",
              "required": ["customerId", "items"],
              "properties": {
                "customerId": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["productId", "quantity"],
                    "properties": {
                      "productId": {
                        "type": "string"
                      },
                      "quantity": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            },
            "example": {
              "customerId": "customer-demo-01",
              "items": [
                {
                  "productId": "product-demo-01",
                  "quantity": 2
                }
              ]
            }
          },
          "responses": {
            "201": {
              "description": "Order created",
              "schema": {
                "type": "object",
                "required": ["id", "status"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "const": "created"
                  }
                }
              },
              "example": {
                "id": "order-demo-01",
                "status": "created"
              }
            },
            "400": {
              "description": "Invalid or empty basket",
              "example": {
                "code": "INVALID_ORDER",
                "message": "At least one valid line item is required."
              }
            },
            "401": {
              "description": "Authentication required",
              "example": {
                "code": "UNAUTHENTICATED"
              }
            },
            "409": {
              "description": "Insufficient stock",
              "example": {
                "code": "INSUFFICIENT_STOCK",
                "productId": "product-demo-01"
              }
            }
          }
        },
        "notes": [
          "All identifiers and examples are synthetic.",
          "A verified contract test is not business acceptance or proof of a deployed service."
        ]
      }
    },
    {
      "sourceIds": ["commerce-service"],
      "status": "verified",
      "evidence": "reviewed",
      "tags": ["Validation"],
      "id": "validate-order",
      "kind": "service",
      "label": "Validate basket",
      "description": "Checks nonempty line items, positive quantities, and current product availability before persisting anything.",
      "moduleId": "orders-module",
      "details": {
        "notes": [
          "Reject invalid requests before a database write.",
          "The check and reservation must share a consistent transaction boundary."
        ]
      }
    },
    {
      "sourceIds": ["commerce-service"],
      "status": "implemented",
      "evidence": "reviewed",
      "tags": ["Application service"],
      "id": "order-service",
      "kind": "service",
      "label": "OrderService",
      "description": "Coordinates validation and order creation within a transaction, then maps the persisted record to the public response.",
      "moduleId": "orders-module",
      "details": {
        "code": "async function createOrder(input, actor) {\n  const basket = await validateBasket(input.items);\n  return transaction(async () => {\n    const order = await orders.insert(actor.customerId, basket);\n    return { id: order.id, status: \"created\" };\n  });\n}",
        "notes": ["Illustrative pseudocode for this synthetic project."]
      }
    },
    {
